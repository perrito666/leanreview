{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://perrito666.github.io/leanreview/schema/leanreview-theme.schema.json",
 "title": "leanreview theme",
 "description": "A leanreview theme file: metadata plus per-role style overrides layered on the default palette. Files live in a themes/ folder next to the config; the \"name\" (not the filename) is how the config's theme setting references it. Built-in names (default, default-light, default-dark, mono) are reserved.",
 "type": "object",
 "required": [
  "name",
  "styles"
 ],
 "additionalProperties": false,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "not": {
    "enum": [
     "default",
     "default-light",
     "default-dark",
     "mono"
    ]
   },
   "description": "The name the config references. Built-in theme names are reserved."
  },
  "description": {
   "type": "string"
  },
  "author": {
   "type": "string"
  },
  "styles": {
   "type": "object",
   "additionalProperties": false,
   "description": "Role overrides; roles you omit keep the default palette.",
   "properties": {
    "addition": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "fg": {
       "type": "string",
       "description": "Foreground: an ANSI palette index (\"114\") or hex (\"#87d787\")."
      },
      "bg": {
       "type": "string",
       "description": "Background, same formats as fg."
      },
      "bold": {
       "type": "boolean"
      },
      "underline": {
       "type": "boolean"
      },
      "reverse": {
       "type": "boolean"
      }
     }
    },
